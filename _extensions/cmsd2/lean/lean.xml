<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE language>
<!--
  Lean 4 syntax highlighting for Pandoc/Quarto (KDE syntax-definition format,
  which Pandoc's skylighting reads). The extension sets it as a
  `syntax-definitions` entry for both the PDF and HTML formats.

  Deliberately small: declarations and control keywords, common tactics,
  sorts, comments and docstrings, attributes, strings, numbers and the
  usual Unicode operators. Identifiers keep `.`, `_`, `'`, `!` and `?` as
  word characters, so `hX.const_mul` and `simp?` are never split.
-->
<language name="Lean" section="Sources" version="1" kateversion="5.0"
          extensions="*.lean" mimetype="text/x-lean" license="MIT">
  <highlighting>
    <list name="keywords">
      <item>theorem</item> <item>lemma</item> <item>def</item>
      <item>abbrev</item> <item>example</item> <item>instance</item>
      <item>structure</item> <item>class</item> <item>inductive</item>
      <item>where</item> <item>extends</item> <item>deriving</item>
      <item>namespace</item> <item>section</item> <item>end</item>
      <item>open</item> <item>variable</item> <item>universe</item>
      <item>noncomputable</item> <item>private</item> <item>protected</item>
      <item>public</item> <item>partial</item> <item>unsafe</item>
      <item>mutual</item> <item>axiom</item> <item>opaque</item>
      <item>export</item> <item>scoped</item> <item>local</item>
      <item>set_option</item> <item>attribute</item> <item>notation</item>
      <item>infix</item> <item>infixl</item> <item>infixr</item>
      <item>prefix</item> <item>postfix</item> <item>macro</item>
      <item>macro_rules</item> <item>syntax</item> <item>elab</item>
      <item>fun</item> <item>let</item> <item>have</item> <item>show</item>
      <item>from</item> <item>suffices</item> <item>calc</item>
      <item>match</item> <item>with</item> <item>at</item>
      <item>only</item> <item>using</item> <item>generalizing</item>
      <item>in</item> <item>by</item> <item>do</item>
      <item>termination_by</item> <item>decreasing_by</item>
    </list>
    <list name="control">
      <item>if</item> <item>then</item> <item>else</item>
      <item>for</item> <item>return</item> <item>break</item>
      <item>continue</item>
    </list>
    <list name="imports">
      <item>import</item> <item>module</item>
    </list>
    <list name="sorts">
      <item>Type</item> <item>Prop</item> <item>Sort</item>
    </list>
    <list name="constants">
      <item>True</item> <item>False</item> <item>true</item> <item>false</item>
    </list>
    <list name="tactics">
      <item>rw</item> <item>rwa</item> <item>erw</item> <item>simp</item>
      <item>simp_all</item> <item>simpa</item> <item>simp_rw</item>
      <item>dsimp</item> <item>exact</item> <item>apply</item>
      <item>refine</item> <item>intro</item> <item>intros</item>
      <item>rintro</item> <item>obtain</item> <item>rcases</item>
      <item>cases</item> <item>induction</item> <item>constructor</item>
      <item>use</item> <item>exists</item> <item>existsi</item>
      <item>left</item> <item>right</item> <item>exfalso</item>
      <item>contradiction</item> <item>by_contra</item> <item>by_cases</item>
      <item>push_neg</item> <item>specialize</item> <item>unfold</item>
      <item>conv</item> <item>congr</item> <item>gcongr</item>
      <item>ext</item> <item>funext</item> <item>symm</item>
      <item>trans</item> <item>subst</item> <item>assumption</item>
      <item>trivial</item> <item>rfl</item> <item>decide</item>
      <item>norm_num</item> <item>ring</item> <item>ring_nf</item>
      <item>field_simp</item> <item>linarith</item> <item>nlinarith</item>
      <item>positivity</item> <item>omega</item> <item>aesop</item>
      <item>tauto</item> <item>fun_prop</item> <item>measurability</item>
      <item>continuity</item> <item>filter_upwards</item>
      <item>exact_mod_cast</item> <item>push_cast</item> <item>norm_cast</item>
      <item>split</item> <item>split_ifs</item> <item>change</item>
      <item>refine'</item> <item>convert</item> <item>calc</item>
      <item>first</item> <item>repeat</item> <item>try</item>
      <item>all_goals</item> <item>any_goals</item> <item>focus</item>
      <item>exact?</item> <item>apply?</item> <item>simp?</item>
    </list>
    <list name="alerts">
      <item>sorry</item> <item>admit</item>
    </list>

    <contexts>
      <!--
        Brackets are coloured by nesting depth, like VS Code's bracket pair
        colourisation: ( [ { and ⟨ all count, and depth cycles 1, 2, 3, 1...
        Normal is depth 0; each opener pushes the next level and each closer
        pops back. A closer with no opener (a snippet cut mid-expression)
        just takes the depth-1 colour.
      -->
      <context name="Normal" attribute="Normal Text" lineEndContext="#stay">
        <IncludeRules context="Code"/>
        <AnyChar attribute="Bracket 1" context="Depth1" String="([{⟨"/>
        <AnyChar attribute="Bracket 1" context="#stay" String=")]}⟩"/>
      </context>
      <context name="Depth1" attribute="Normal Text" lineEndContext="#stay">
        <IncludeRules context="Code"/>
        <AnyChar attribute="Bracket 2" context="Depth2" String="([{⟨"/>
        <AnyChar attribute="Bracket 1" context="#pop" String=")]}⟩"/>
      </context>
      <context name="Depth2" attribute="Normal Text" lineEndContext="#stay">
        <IncludeRules context="Code"/>
        <AnyChar attribute="Bracket 3" context="Depth3" String="([{⟨"/>
        <AnyChar attribute="Bracket 2" context="#pop" String=")]}⟩"/>
      </context>
      <context name="Depth3" attribute="Normal Text" lineEndContext="#stay">
        <IncludeRules context="Code"/>
        <AnyChar attribute="Bracket 1" context="Depth1" String="([{⟨"/>
        <AnyChar attribute="Bracket 3" context="#pop" String=")]}⟩"/>
      </context>

      <!-- Everything except brackets; shared by every depth. -->
      <context name="Code" attribute="Normal Text" lineEndContext="#stay">
        <!-- Docstrings and module docs before plain block comments. -->
        <StringDetect attribute="Documentation" context="DocComment" String="/--"/>
        <StringDetect attribute="Documentation" context="DocComment" String="/-!"/>
        <Detect2Chars attribute="Comment" context="BlockComment" char="/" char1="-"/>
        <Detect2Chars attribute="Comment" context="LineComment" char="-" char1="-"/>
        <RegExpr attribute="Attribute" context="#stay" String="@\[[^\]]*\]"/>
        <DetectChar attribute="String" context="String" char="&quot;"/>
        <keyword attribute="Import" context="#stay" String="imports"/>
        <keyword attribute="Keyword" context="#stay" String="keywords"/>
        <keyword attribute="Control Flow" context="#stay" String="control"/>
        <keyword attribute="Data Type" context="#stay" String="sorts"/>
        <keyword attribute="Constant" context="#stay" String="constants"/>
        <keyword attribute="Tactic" context="#stay" String="tactics"/>
        <keyword attribute="Alert" context="#stay" String="alerts"/>
        <RegExpr attribute="Number" context="#stay" String="\b[0-9]+(\.[0-9]+)?\b"/>
        <StringDetect attribute="Operator" context="#stay" String=":="/>
        <StringDetect attribute="Operator" context="#stay" String="=&gt;"/>
        <StringDetect attribute="Operator" context="#stay" String="&lt;;&gt;"/>
        <AnyChar attribute="Operator" context="#stay" String="→←↔↦∀∃λ∘×≤≥≠¬∧∨∈∉⊆∩∪∫∑∏∂⁻¹·•∣"/>
      </context>

      <context name="LineComment" attribute="Comment" lineEndContext="#pop"/>

      <!-- Lean block comments nest, so each opener pushes another level. -->
      <context name="BlockComment" attribute="Comment" lineEndContext="#stay">
        <Detect2Chars attribute="Comment" context="BlockComment" char="/" char1="-"/>
        <Detect2Chars attribute="Comment" context="#pop" char="-" char1="/"/>
      </context>

      <context name="DocComment" attribute="Documentation" lineEndContext="#stay">
        <Detect2Chars attribute="Documentation" context="DocNested" char="/" char1="-"/>
        <Detect2Chars attribute="Documentation" context="#pop" char="-" char1="/"/>
      </context>
      <context name="DocNested" attribute="Documentation" lineEndContext="#stay">
        <Detect2Chars attribute="Documentation" context="DocNested" char="/" char1="-"/>
        <Detect2Chars attribute="Documentation" context="#pop" char="-" char1="/"/>
      </context>

      <context name="String" attribute="String" lineEndContext="#stay">
        <RegExpr attribute="Special Char" context="#stay" String="\\."/>
        <DetectChar attribute="String" context="#pop" char="&quot;"/>
      </context>
    </contexts>

    <!--
      Mapped to look like the VS Code Lean 4 extension in the Light+ theme
      (see vscode-light.theme in this extension): control words, imports and sorts
      share the keyword colour, and tactics stay plain. Tactics use the
      "Others" style rather than "Normal" so a theme can still pick them out.
    -->
    <itemDatas>
      <itemData name="Normal Text"   defStyleNum="dsNormal"/>
      <itemData name="Keyword"       defStyleNum="dsKeyword"/>
      <itemData name="Control Flow"  defStyleNum="dsKeyword"/>
      <itemData name="Import"        defStyleNum="dsKeyword"/>
      <itemData name="Data Type"     defStyleNum="dsKeyword"/>
      <itemData name="Constant"      defStyleNum="dsConstant"/>
      <itemData name="Tactic"        defStyleNum="dsOthers"/>
      <itemData name="Alert"         defStyleNum="dsAlert"/>
      <itemData name="Attribute"     defStyleNum="dsAttribute"/>
      <itemData name="Number"        defStyleNum="dsDecVal"/>
      <itemData name="String"        defStyleNum="dsString"/>
      <itemData name="Special Char"  defStyleNum="dsSpecialChar"/>
      <itemData name="Operator"      defStyleNum="dsOperator"/>
      <itemData name="Comment"       defStyleNum="dsComment"/>
      <itemData name="Documentation" defStyleNum="dsDocumentation"/>
      <!-- Styles that Pandoc's Python highlighter never produces, so the
           theme can give them bracket colours without touching Python. -->
      <itemData name="Bracket 1"     defStyleNum="dsExtension"/>
      <itemData name="Bracket 2"     defStyleNum="dsAnnotation"/>
      <itemData name="Bracket 3"     defStyleNum="dsInformation"/>
    </itemDatas>
  </highlighting>

  <general>
    <comments>
      <comment name="singleLine" start="--"/>
      <comment name="multiLine" start="/-" end="-/"/>
    </comments>
    <keywords casesensitive="1" weakDeliminator="._'!?"/>
  </general>
</language>
